generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  runtime         = "nodejs"
  // Índices con WHERE (ver Reserva): todavía en preview en Prisma 7
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  JUGADOR
  DUENIO
  ADMIN
}

enum Deporte {
  FUTBOL_5
  FUTBOL_7
  FUTBOL_11
  TENIS
  PADEL
  BASQUET
}

enum TipoSuperficie {
  CESPED_SINTETICO
  CESPED_NATURAL
  CEMENTO
  PARQUET
  POLVO_DE_LADRILLO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  dni          String?  @unique
  telefono     String?
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complejos Complejo[] @relation("DuenioComplejos")
  reservas  Reserva[]  @relation("JugadorReservas")
}

model Complejo {
  id                       String   @id @default(cuid())
  nombre                   String
  direccion                String
  zona                     String
  contacto                 String
  duenioId                 String
  // Baja lógica: al dar de baja no se borra, para conservar el historial de reservas
  activo                   Boolean  @default(true)
  // % de seña por defecto de sus canchas; cada Cancha puede pisarlo con el propio
  porcentajeSenaDefault    Int      @default(30)
  // Minutos de anticipación mínima para reservar, por defecto de sus canchas;
  // cada Cancha puede pisarlo con el propio. 0 = hasta que empieza el turno.
  // Default 180 = 3 horas (mismo valor que arranca el form de alta)
  minAdvanceMinutesDefault Int      @default(180)
  // Horas antes del turno hasta las que se puede cancelar con devolución de
  // la seña. Aplica a todas sus canchas (no hay override por cancha).
  cancellationHours        Int      @default(24)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  duenio   Usuario          @relation("DuenioComplejos", fields: [duenioId], references: [id])
  canchas  Cancha[]
  imagenes ImagenComplejo[]

  @@index([zona])
  @@index([duenioId])
}

model ImagenComplejo {
  id         String  @id @default(cuid())
  complejoId String
  url        String
  orden      Int     @default(0)
  activo     Boolean @default(true)

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)

  @@index([complejoId])
}

model Cancha {
  id                String         @id @default(cuid())
  complejoId        String
  nombre            String
  deporte           Deporte
  tipoSuperficie    TipoSuperficie
  capacidad         Int
  precioBase        Decimal        @db.Decimal(10, 2)
  horaApertura      String
  horaCierre        String
  duracionTurnoMin  Int            @default(60)
  // % de seña propio; si es null, se usa el porcentajeSenaDefault del complejo
  porcentajeSena    Int?
  // Anticipación mínima propia; si es null, se usa minAdvanceMinutesDefault del complejo
  minAdvanceMinutes Int?
  activo            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  complejo          Complejo         @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  reservas          Reserva[]
  preciosEspeciales PrecioEspecial[]
  blocks            Block[]

  @@index([complejoId])
  @@index([deporte])
}

// Bloqueo de horario de una cancha (mantenimiento, evento privado, etc).
// El horario [startTime, endTime) se bloquea todos los días entre startDate y endDate.
model Block {
  id        String   @id @default(cuid())
  courtId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  startTime String
  endTime   String
  // Nota interna del dueño, nunca se muestra al jugador
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court Cancha @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startDate, endDate])
}

model PrecioEspecial {
  id         String  @id @default(cuid())
  canchaId   String
  // 0 (domingo) a 6 (sábado); null = todos los días
  diaSemana  Int?
  // franja horaria; null junto con horaFin = todo el día
  horaInicio String?
  horaFin    String?
  precio     Decimal @db.Decimal(10, 2)
  activo     Boolean @default(true)

  cancha Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId])
}

model Reserva {
  id          String        @id @default(cuid())
  canchaId    String
  jugadorId   String
  fecha       DateTime      @db.Date
  horaInicio  String
  horaFin     String
  estado      EstadoReserva @default(PENDIENTE)
  asistio     Boolean?
  // Precio del turno congelado al momento de reservar (no se recalcula
  // aunque después cambie precioBase o haya un PrecioEspecial nuevo).
  precioTurno Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cancha  Cancha  @relation(fields: [canchaId], references: [id])
  jugador Usuario @relation("JugadorReservas", fields: [jugadorId], references: [id])
  pago    Pago?

  // Última defensa contra doble reserva: no puede haber dos reservas activas
  // en la misma cancha, fecha y hora de inicio. Las canceladas no cuentan:
  // así un turno cancelado se vuelve a reservar con una fila nueva y la
  // cancelada queda en el historial de su jugador, con su pago.
  @@unique([canchaId, fecha, horaInicio], map: "Reserva_activa_unica", where: raw("estado <> 'CANCELADA'"))
  @@index([jugadorId])
  @@index([canchaId, fecha])
}

model Pago {
  id                String   @id @default(cuid())
  reservaId         String   @unique
  // monto y porcentaje quedan congelados: si después cambia el % de seña
  // de la cancha/complejo, esta reserva ya pagada no se ve afectada
  monto             Decimal  @db.Decimal(10, 2)
  porcentaje        Int
  // Política de cancelación del complejo al momento de pagar, congelada igual
  // que porcentaje. Al cancelar vale la más corta entre esta y la actual.
  cancellationHours Int      @default(24)
  // false hasta que se decide la devolución al cancelar
  devuelto          Boolean  @default(false)
  createdAt         DateTime @default(now())

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
}

// Un intento de login fallido o un registro, para limitar abuso por fuerza
// bruta (ver lib/limite-intentos.ts). clave = "login:<email>:<ip>", etc.
model Intento {
  id        String   @id @default(cuid())
  clave     String
  createdAt DateTime @default(now())

  @@index([clave, createdAt])
}
