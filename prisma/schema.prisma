generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  runtime         = "nodejs"
  // Índices con WHERE (ver Reserva): todavía en preview en Prisma 7
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  JUGADOR
  DUENIO
  ADMIN
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum Deporte {
  FUTBOL_5
  FUTBOL_7
  FUTBOL_11
  TENIS
  PADEL
  BASQUET
}

enum TipoSuperficie {
  CESPED_SINTETICO
  CESPED_NATURAL
  CEMENTO
  PARQUET
  POLVO_DE_LADRILLO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum EstadoDisputa {
  ABIERTA
  RESUELTA
}

enum DecisionDisputa {
  A_FAVOR_JUGADOR
  A_FAVOR_DUENIO
}

enum TipoEvidencia {
  IMAGEN
  VIDEO
}

enum EstadoTicket {
  PENDIENTE
  ANULADO // evidencia validada: no penaliza
  CONFIRMADO // evidencia rechazada: penaliza
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  dni          String?  @unique
  telefono     String?
  imagenUrl    String?
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complejos         Complejo[]            @relation("DuenioComplejos")
  reservas          Reserva[]             @relation("JugadorReservas")
  participaciones   ParticipanteReserva[] @relation("ParticipacionesDelJugador")
  disputas          Disputa[]             @relation("DisputasDelJugador")
  disputasResueltas Disputa[]             @relation("DisputasResueltas")
  calificaciones    Calificacion[]        @relation("CalificacionesDelJugador")
  etiquetas         EtiquetaReserva[]     @relation("EtiquetasDelJugador")
  ticketsRecibidos  Ticket[]              @relation("TicketsDelJugador")
  ticketsResueltos  Ticket[]              @relation("TicketsResueltos")
}

model Complejo {
  id                       String           @id @default(cuid())
  nombre                   String
  direccion                String
  zona                     String
  contacto                 String
  duenioId                 String
  // Baja lógica: al dar de baja no se borra, para conservar el historial de reservas
  activo                   Boolean          @default(true)
  // % de seña por defecto de sus canchas; cada Cancha puede pisarlo con el propio
  porcentajeSenaDefault    Int              @default(30)
  // Minutos de anticipación mínima para reservar, por defecto de sus canchas;
  // cada Cancha puede pisarlo con el propio. 0 = hasta que empieza el turno.
  // Default 180 = 3 horas (mismo valor que arranca el form de alta)
  minAdvanceMinutesDefault Int              @default(180)
  // Horas antes del turno hasta las que se puede cancelar con devolución de
  // la seña. Aplica a todas sus canchas (no hay override por cancha).
  cancellationHours        Int              @default(24)
  // Un complejo nuevo no lo ven los jugadores hasta que un admin lo aprueba
  estadoAprobacion         EstadoAprobacion @default(PENDIENTE)
  // Lo escribe el admin al rechazar; se borra cuando el dueño lo corrige
  motivoRechazo            String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  duenio         Usuario          @relation("DuenioComplejos", fields: [duenioId], references: [id])
  canchas        Cancha[]
  imagenes       ImagenComplejo[]
  calificaciones Calificacion[]

  @@index([zona])
  @@index([duenioId])
}

model ImagenComplejo {
  id         String  @id @default(cuid())
  complejoId String
  url        String
  orden      Int     @default(0)
  activo     Boolean @default(true)

  complejo Complejo @relation(fields: [complejoId], references: [id], onDelete: Cascade)

  @@index([complejoId])
}

model Cancha {
  id                String         @id @default(cuid())
  complejoId        String
  nombre            String
  deporte           Deporte
  tipoSuperficie    TipoSuperficie
  // Máximo de jugadores por reserva (ambos equipos): hasta acá se pueden sumar
  capacidad         Int
  precioBase        Decimal        @db.Decimal(10, 2)
  horaApertura      String
  horaCierre        String
  duracionTurnoMin  Int            @default(60)
  // % de seña propio; si es null, se usa el porcentajeSenaDefault del complejo
  porcentajeSena    Int?
  // Anticipación mínima propia; si es null, se usa minAdvanceMinutesDefault del complejo
  minAdvanceMinutes Int?
  activo            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  complejo          Complejo         @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  reservas          Reserva[]
  preciosEspeciales PrecioEspecial[]
  blocks            Block[]
  preparation      Preparation[]

  @@index([complejoId])
  @@index([deporte])
}

// Bloqueo de horario de una cancha (mantenimiento, evento privado, etc).
// El horario [startTime, endTime) se bloquea todos los días entre startDate y endDate.
model Block {
  id        String   @id @default(cuid())
  courtId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  startTime String
  endTime   String
  // Nota interna del dueño, nunca se muestra al jugador
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court Cancha @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startDate, endDate])
}

model PrecioEspecial {
  id         String  @id @default(cuid())
  canchaId   String
  // 0 (domingo) a 6 (sábado); null = todos los días
  diaSemana  Int?
  // franja horaria; null junto con horaFin = todo el día
  horaInicio String?
  horaFin    String?
  precio     Decimal @db.Decimal(10, 2)
  activo     Boolean @default(true)

  cancha Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId])
}

model Reserva {
  id                  String        @id @default(cuid())
  canchaId            String
  jugadorId           String
  fecha               DateTime      @db.Date
  horaInicio          String
  horaFin             String
  estado              EstadoReserva @default(PENDIENTE)
  asistio             Boolean?
  // Cuándo el dueño marcó la asistencia. El plazo para disputar corre desde
  // acá y no desde el turno: si el dueño vuelve a marcar no-show, el jugador
  // tiene de nuevo los 7 días para disputar.
  asistenciaMarcadaEn DateTime?
  // Precio del turno congelado al momento de reservar (no se recalcula
  // aunque después cambie precioBase o haya un PrecioEspecial nuevo).
  precioTurno         Decimal       @db.Decimal(10, 2)
  // Descuento por nivel del jugador, congelado al reservar. Lo paga la
  // plataforma: el jugador paga precioTurno - descuento y el dueño cobra igual
  // el precioTurno entero. 0 = sin descuento (también las reservas viejas).
  descuento           Decimal       @default(0) @db.Decimal(10, 2)
  // Jugadores cargados cuando la reserva está incompleta. null = completa
  // (también las reservas viejas). Un número menor al máximo del deporte =
  // incompleta; faltan (máximo - jugadores) para completar.
  jugadores           Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  cancha         Cancha                @relation(fields: [canchaId], references: [id])
  jugador        Usuario               @relation("JugadorReservas", fields: [jugadorId], references: [id])
  participantes  ParticipanteReserva[]
  pago           Pago?
  disputa        Disputa?
  calificaciones Calificacion[]
  etiquetas      EtiquetaReserva[]

  // Última defensa contra doble reserva: no puede haber dos reservas activas
  // en la misma cancha, fecha y hora de inicio. Las canceladas no cuentan:
  // así un turno cancelado se vuelve a reservar con una fila nueva y la
  // cancelada queda en el historial de su jugador, con su pago.
  @@unique([canchaId, fecha, horaInicio], map: "Reserva_activa_unica", where: raw("estado <> 'CANCELADA'"))
  @@index([jugadorId])
  @@index([canchaId, fecha])
}

// Jugadores que se sumaron a una reserva incompleta de otro. El creador no va
// acá (ya es el jugador de la Reserva); sirve para saber quién ya está adentro
// y así no ofrecerle sumarse de nuevo. La cuenta total de personas vive en
// Reserva.jugadores; esto es solo la membresía.
model ParticipanteReserva {
  id        String @id @default(cuid())
  reservaId String
  jugadorId String
  // Cuántos jugadores aportó al sumarse. Al salirse se resta esto de
  // Reserva.jugadores, así el cupo vuelve a quedar bien.
  jugadores Int

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  jugador Usuario @relation("ParticipacionesDelJugador", fields: [jugadorId], references: [id])

  // Un jugador no puede sumarse dos veces a la misma reserva
  @@unique([reservaId, jugadorId])
  @@index([reservaId])
}

model Pago {
  id                String   @id @default(cuid())
  reservaId         String   @unique
  // monto y porcentaje quedan congelados: si después cambia el % de seña
  // de la cancha/complejo, esta reserva ya pagada no se ve afectada
  monto             Decimal  @db.Decimal(10, 2)
  porcentaje        Int
  // Política de cancelación del complejo al momento de pagar, congelada igual
  // que porcentaje. Al cancelar vale la más corta entre esta y la actual.
  cancellationHours Int      @default(24)
  // false hasta que se decide la devolución al cancelar
  devuelto          Boolean  @default(false)
  createdAt         DateTime @default(now())

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
}

// Un intento de login fallido o un registro, para limitar abuso por fuerza
// bruta (ver lib/limite-intentos.ts). clave = "login:<email>:<ip>", etc.
model Intento {
  id        String   @id @default(cuid())
  clave     String
  createdAt DateTime @default(now())

  @@index([clave, createdAt])
}

// El jugador cuestiona el no-show que le marcó el dueño. La resuelve un admin
// de la aplicación (no el dueño del complejo) y la decisión queda registrada.
model Disputa {
  id          String @id @default(cuid())
  // Una sola disputa por reserva, incluso si ya se resolvió: no hay reapelación
  reservaId   String @unique
  jugadorId   String
  descripcion String

  estado          EstadoDisputa    @default(ABIERTA)
  decision        DecisionDisputa?
  comentarioAdmin String?
  // null mientras está ABIERTA: todavía no la resolvió ningún admin
  adminId         String?
  resueltaEn      DateTime?

  createdAt DateTime @default(now())

  reserva    Reserva            @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  jugador    Usuario            @relation("DisputasDelJugador", fields: [jugadorId], references: [id])
  admin      Usuario?           @relation("DisputasResueltas", fields: [adminId], references: [id])
  evidencias EvidenciaDisputa[]

  // Para el listado del admin, que filtra abiertas o resueltas
  @@index([estado])
}

// Amigos etiquetados en una reserva ya finalizada. No aportan cupo (eso es
// ParticipanteReserva); solo registran que ese jugador también jugó, para que
// sume puntos. El que etiqueta es el que hizo la reserva (etiquetadoPor).
model EtiquetaReserva {
  id            String   @id @default(cuid())
  reservaId     String
  jugadorId     String // el etiquetado
  etiquetadoPor String // quién etiquetó (= Reserva.jugadorId)
  createdAt     DateTime @default(now())

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  jugador Usuario @relation("EtiquetasDelJugador", fields: [jugadorId], references: [id])

  // Un jugador no se etiqueta dos veces en la misma reserva
  @@unique([reservaId, jugadorId])
  @@index([reservaId])
  @@index([jugadorId])
}

// El admin penaliza a un jugador para frenar fraude de asistencias. En vez de
// fijar puntos a mano, indica cuántas reservas invalida (reservasInvalidas): la
// penalización es reservasInvalidas * PUNTOS.jugado y se resta del total que se
// deriva de las reservas (ver lib/tickets.ts). El jugador tiene 5 días para
// responder con evidencia; el admin la valida (ANULADO) o la rechaza
// (CONFIRMADO). Pasados los 5 días sin resolver, la penalización se aplica igual
// pero el ticket sigue vivo para que el jugador pueda apelar.
model Ticket {
  id                String       @id @default(cuid())
  jugadorId         String // el penalizado
  adminId           String // quién lo creó
  reservasInvalidas Int
  // Snapshot del total del jugador al crear el ticket, solo para mostrar
  puntosAnteriores  Int
  motivo            String
  estado            EstadoTicket @default(PENDIENTE)
  // createdAt + 5 días: pasado este momento la penalización se aplica sola
  venceEn           DateTime
  comentarioJugador String? // lo que escribió al responder o apelar
  respondidoEn      DateTime?
  comentarioAdmin   String?
  resueltoEn        DateTime?
  createdAt         DateTime     @default(now())

  jugador    Usuario           @relation("TicketsDelJugador", fields: [jugadorId], references: [id])
  admin      Usuario           @relation("TicketsResueltos", fields: [adminId], references: [id])
  evidencias EvidenciaTicket[]

  @@index([jugadorId])
  @@index([estado])
}

// La evidencia que sube el jugador para responder un ticket. Mismo patrón que
// EvidenciaDisputa: imágenes a Vercel Blob.
model EvidenciaTicket {
  id       String        @id @default(cuid())
  ticketId String
  url      String
  tipo     TipoEvidencia @default(IMAGEN)
  orden    Int           @default(0)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Una prueba que subió el jugador (a Vercel Blob, como las fotos de complejo).
// Hoy solo se suben imágenes; el tipo está para cuando entren los videos.
model EvidenciaDisputa {
  id        String        @id @default(cuid())
  disputaId String
  url       String
  tipo      TipoEvidencia
  orden     Int           @default(0)

  disputa Disputa @relation(fields: [disputaId], references: [id], onDelete: Cascade)

  @@index([disputaId])
}

// Estrellas que un jugador le pone a un complejo después de jugar. Una por
// reserva y por jugador: el que reservó y cada uno que se sumó califican por
// separado. El puntaje (1 a 5) lo valida el endpoint con Zod.
model Calificacion {
  id         String   @id @default(cuid())
  reservaId  String
  jugadorId  String
  // Se podría sacar de reserva → cancha → complejo, pero guardarlo acá deja
  // calcular el promedio de un complejo sin joins (ver índice de abajo).
  complejoId String
  puntaje    Int
  comentario String?
  createdAt  DateTime @default(now())

  reserva  Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  jugador  Usuario  @relation("CalificacionesDelJugador", fields: [jugadorId], references: [id])
  complejo Complejo @relation(fields: [complejoId], references: [id])

  // Corta también dos pedidos a la vez: el segundo falla con P2002
  @@unique([reservaId, jugadorId])
  // Promedio y cantidad por complejo (búsqueda y detalle)
  @@index([complejoId])
  // Cuántas calificó cada jugador (gamificación)
  @@index([jugadorId])
}

model Preparation {
  id        String   @id @default(cuid())
  canchaId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparation Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@index([canchaId, startDate, endDate])
}