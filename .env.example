# Base de datos PostgreSQL. Opciones:
#  - SIN INTERNET (parcial):  Postgres local de Homebrew → npm run setup:local
#                             (arma este archivo solo: DATABASE_URL, AUTH_SECRET y UPLOADS_LOCAL)
#                             DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/tocayjuga"
#  - Prisma Postgres gratis:  npx create-db   (o https://console.prisma.io)
#  - Local sin Docker:        npm run db:dev  (usa el string que imprime; NECESITA internet)
#  - Neon / Supabase:         copiar el connection string del dashboard
DATABASE_URL=""

# Auth.js — generar con: npx auth secret
AUTH_SECRET=""

# Dónde se guardan las fotos subidas:
#  - vacío:  Vercel Blob (necesita BLOB_READ_WRITE_TOKEN y internet)
#  - "true": en public/uploads (sin internet)
UPLOADS_LOCAL=""

# Vercel Blob — token del store (Vercel lo genera al crear el Blob store)
BLOB_READ_WRITE_TOKEN=""
